NODE_ENV=
PORT=
DATABASE_URL=
# This server's own public URL — used only to embed the logo (served from
# /assets) in outgoing emails. DEV_BACKEND_URL falls back to
# http://localhost:<DEV_PORT> if unset; BACKEND_URL has no fallback and
# must be the real deployed URL in production.
BACKEND_URL=
DEV_BACKEND_URL=
APP_SECRET=
SMTP_GMAIL_USER=
SMTP_GMAIL_PASSWORD=
ZEPTOMAIL_TOKEN=
# Email always sends via ZeptoMail's HTTPS API (never SMTP — see
# email-sender.ts for why). Falls back to ZEPTOMAIL_TOKEN if unset.
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email
ZEPTO_EMAIL_FROM=
REDIS_URL=
DVP_BASE_URL=
DVP_SECRET_KEY=
DVP_PROGRAM_ID=
MESSAGES_NOTIFY_EMAIL=
# Production (NODE_ENV=production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Development (NODE_ENV=development)
DEV_CLOUDINARY_CLOUD_NAME=
DEV_CLOUDINARY_API_KEY=
DEV_CLOUDINARY_API_SECRET=

# Optional
DB_POOL_MAX=5
DB_SYNC_ALTER=false
CAPTCHA_SECRET_KEY=
# Extra browser origins allowed by CORS (comma-separated), in addition to FRONTEND_URL
CORS_ORIGINS=
